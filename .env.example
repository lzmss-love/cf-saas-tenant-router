# ==== Cloudflare 账号凭证 ====
# 只给脚本需要的最小权限，不要给全局编辑 token
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ==== Zone ====
# 你挂在 Cloudflare 上的 SaaS 宿主域名（客户域名挂它下面）
CF_SaaS_ZONE_ID=
CF_SaaS_ZONE_NAME=your-saas-domain.com

# 给租户指向的入口（CNAME target）
CF_CUSTOMER_CNAME_TARGET=customers.your-saas-domain.com

# ==== Worker ====
# 部署后由 wrangler 写入 wrangler.jsonc
CF_WORKER_NAME=saas-tenant-router

# ==== D1 租户表 ====
# npx wrangler d1 create saas-tenants 后填入
CF_D1_DATABASE_ID=

# ==== 可选 ====
# 用来给 zone 自己的 DNS 记录做标记的名字
CF_FALLBACK_NAME=service

# ==== 管理接口 ====
# 用来调 /__saas/admin/* 的 Bearer token，随机长串即可
CF_ADMIN_TOKEN=
